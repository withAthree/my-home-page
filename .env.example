# ============================================================================
#  部署参数模板 —— 复制成 .env 再改（.env 已被 .gitignore 忽略，不会进仓库）
#    copy .env.example .env        Windows
#    cp   .env.example .env        Linux / macOS
# ============================================================================

# ---- 对外访问端口（docker-compose.yml）----
# 服务器上若已有 Nginx/Caddy/1Panel 占着 80，就用 8080 之类，再让它们反代过来
WEB_PORT=8080

# ---- 镜像名与标签 ----
# 用私有仓库 / 阿里云 ACR 时改 IMAGE_NAME，例如
#   IMAGE_NAME=registry.cn-hangzhou.aliyuncs.com/your-ns/my-home-page
IMAGE_NAME=my-home-page
IMAGE_TAG=latest
CONTAINER_NAME=my-home-page

# ---- 构建加速（国内服务器强烈建议改）----
# 阿里云服务器访问 registry.npmjs.org 经常几百 KB/s，换成国内镜像能快一个数量级
NPM_REGISTRY=https://registry.npmmirror.com
# NPM_REGISTRY=https://registry.npmjs.org

# 基础镜像也可以换成镜像站地址（服务器拉不到 Docker Hub 时用）
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.29-alpine
# CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2-alpine

# 构建时顺带跑内容校验（必填项、图片是否存在、生成器幂等）；1=开启
RUN_CONTENT_CHECK=0

# ---- HTTPS 方案（docker-compose.tls.yml 用）----
# 必须先把域名解析到这台服务器，并且放行 80 / 443
SITE_DOMAIN=xuqingchu.dev
# 想收 Let's Encrypt 证书邮件：改 deploy/caddy/Caddyfile 里被注释掉的 email 行，
# 不要在这里塞空值（Caddy 会解析失败）

# ---- 时区（影响日志时间）----
TZ=Asia/Shanghai
